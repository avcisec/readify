# Copy to .env only when overriding the safe local defaults.
# Values are intentionally non-secret local placeholders.
APP_ENV=local
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=debug

READIFY_POSTGRES_PORT=55431
DATABASE_URL=postgresql://readify:readify@127.0.0.1:55431/readify
READIFY_UPLOAD_DIR=.data/uploads
PYTHON=python3
READIFY_PDF_EXTRACTOR=scripts/extract_pdf.py
READIFY_OCR_DPI=300
QUEUE_BACKEND=postgres
IDENTITY_ADAPTER=outbox
MEANING_ADAPTER=fixture
LANGUAGE_ANALYZER_ADAPTER=recorded
SESSION_COOKIE_NAME=readify_session

# Add provider credentials only to an untracked .env. Keep providers disabled
# when credentials are absent; tests must use fakes or recorded fixtures.
AI_PROVIDER_API_KEY=
EMAIL_PROVIDER_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
